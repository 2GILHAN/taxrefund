# ----- 분석 모델 (config.yaml의 analyze.provider로 선택) -----

# Gemini (기본) — 무료 등급이 있어 카드 등록 없이 시작할 수 있습니다
# https://aistudio.google.com/apikey 에서 발급 (AIza... 로 시작)
GEMINI_API_KEY=

# Claude (analyze.provider를 claude로 바꿀 때만) — 유료
# https://console.anthropic.com/ 에서 발급 (sk-ant- 로 시작)
ANTHROPIC_API_KEY=

# ----- 국가법령정보 OPEN API -----
# https://open.law.go.kr/LSO/openApi/cuAskList.do 에서 무료 신청
# OC 값은 신청한 이메일의 @ 앞부분 (예: 2gilhan@gmail.com -> 2gilhan)
# 신청 시 이 봇을 돌릴 서버의 공인 IP를 반드시 등록해야 합니다.
LAW_API_OC=

# ----- 디스코드 봇 알림 -----
# 아래 둘을 채우면 됩니다. 비워 두면 알림은 콘솔/파일로만 나가고,
# 나중에 채운 뒤 `python -m taxrefund backfill`로 밀린 알림을 받을 수 있습니다.
# (서버를 켜 둔 채로 채우면 다음 사이클에 자동으로 감지합니다.)
#
#   1. https://discord.com/developers/applications -> New Application
#   2. Bot 탭 -> Reset Token -> 토큰 복사 -> DISCORD_BOT_TOKEN
#   3. General Information의 Application ID를 아래 <APP_ID>에 넣어 열고 서버에 초대:
#      https://discord.com/oauth2/authorize?client_id=<APP_ID>&scope=bot&permissions=18432
#      (permissions 18432 = Send Messages + Embed Links)
#   4. 디스코드 설정 > 고급 > 개발자 모드 ON
#      -> 알림 받을 채널 우클릭 > "채널 ID 복사" -> DISCORD_CHANNEL_ID
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# (선택) 봇 대신 웹훅을 쓰고 싶을 때만. 봇 토큰이 있으면 봇이 우선합니다.
DISCORD_WEBHOOK_URL=

# ----- 웹 대시보드 접근 토큰 -----
# 설정하면 http://<주소>:8787?t=<토큰> 으로만 접속됩니다.
# 같은 와이파이 안에서만 쓸 거면 비워 둬도 되지만, 채워 두길 권합니다.
WEB_TOKEN=

# ----- 그 외 알림 채널 (선택) -----
# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=

# SMTP 메일 발송 (Gmail이면 앱 비밀번호 사용)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ----- DART 전자공시 (기업 색인용) -----
# https://opendart.fss.or.kr/ 에서 무료 발급 (40자리)
# 판례 업종에 해당하는 외부감사대상 법인을 찾는 데 씁니다.
DART_API_KEY=
